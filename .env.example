# Database (SQLite — single file, no server required)
DATABASE_URL="file:./database.db"

# NextAuth (v5 reads AUTH_SECRET; NEXTAUTH_SECRET kept for compatibility)
AUTH_SECRET="change-this-to-a-random-32-char-string"
NEXTAUTH_SECRET="change-this-to-a-random-32-char-string"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Admin credentials
ADMIN_EMAIL="admin@library.kz"
# Generate the hash with:
#   node -e "const b=require('bcryptjs');console.log(b.hashSync('your-password',10))"
ADMIN_PASSWORD_HASH="$2b$10$replace.with.your.generated.bcrypt.hash.value.here.0000000"

# File uploads
NEXT_PUBLIC_UPLOAD_URL="/uploads"
