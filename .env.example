# Database (SQLite — single file, no server required)
DATABASE_URL="file:./database.db"

# NextAuth
AUTH_SECRET="change-this-to-a-random-32-char-string"
NEXTAUTH_SECRET="change-this-to-a-random-32-char-string"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Admin credentials
ADMIN_EMAIL="admin@library.kz"
#
# Хеш пароля хранится в base64 (ADMIN_PASSWORD_HASH_B64), потому что
# @next/env раскрывает $VAR в значениях, что ломает bcrypt-хеши вида $2a$10$...
#
# Сгенерировать значение для нового пароля:
#   node -e "const b=require('bcryptjs'); console.log(Buffer.from(b.hashSync('ВАШ_ПАРОЛЬ',10)).toString('base64'))"
ADMIN_PASSWORD_HASH_B64="base64_encoded_bcrypt_hash_here"

# File uploads
NEXT_PUBLIC_UPLOAD_URL="/uploads"
